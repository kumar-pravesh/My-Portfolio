{
  "name": "portfolio-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "admin",
    "backend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:admin\"",
    "build:all": "npm run build --workspace=frontend && npm run build --workspace=admin",
    "build": "npm run build:all && node -e \"require('fs').cpSync('admin/dist', 'frontend/dist/admin', {recursive: true})\"",
    "install:all": "npm install",
    "prepare": "node .husky/install.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.{js,jsx,css,md,json}": "prettier --write"
  }
}
